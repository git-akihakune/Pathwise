# Everything here is optional. Copy to `.env` only if you want to change a default.
# Defaults are shown; uncomment a line to override it.

# Public URL, used in emails and auth callbacks.
# APP_URL=http://localhost:3000

# Host port published for the web service.
# PATHWISE_PORT=3000

# Postgres password. Only reachable on the internal compose network.
# WARNING: changing this after the first start does NOT change the password of the
# existing database (the pathwise-db volume); web/worker would then fail to connect.
# POSTGRES_PASSWORD=pathwise

# Secrets are generated by `init` into the pathwise-secrets volume if unset. Back that volume up.
# APP_ENCRYPTION_KEY=
# BETTER_AUTH_SECRET=

# Email. Leaving SMTP_HOST unset disables email.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Who may add custom LLM endpoints.
# CUSTOM_ENDPOINTS=admin_only

# Allow LLM endpoints on private/loopback addresses.
# ALLOW_PRIVATE_ENDPOINTS=false

# Load the demo persona during init.
# SEED_DEMO=false

# Log prompt/response content. Development only.
# LOG_CONTENT=false

# Log level (pino): trace, debug, info, warn, error, fatal. Empty means info.
# LOG_LEVEL=info

# Optional OpenTelemetry tracing endpoint. Unset disables tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=
