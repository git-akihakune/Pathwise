{
  "name": "pathwise",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "license": "AGPL-3.0-only",
  "scripts": {
    "lint": "biome check .",
    "taxonomy:fixture": "tsx test/fixtures/taxonomy/generate.ts",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "build": "pnpm -r build",
    "dev:db": "docker compose -f compose.dev.yaml up -d --wait",
    "dev:init": "tsx --env-file=dev.env apps/worker/src/main.ts init",
    "dev:worker": "tsx watch --env-file=dev.env apps/worker/src/main.ts worker",
    "dev:web": "pnpm --filter @pathwise/web dev",
    "e2e": "bash scripts/e2e.sh",
    "dev": "pnpm dev:db && pnpm dev:init && pnpm -w run --parallel \"/^dev:(web|worker)$/\""
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "~1.64.0",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^24.0.0",
    "drizzle-orm": "^0.45.4",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.4"
  }
}
